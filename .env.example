# Supabase project settings (Project Settings → API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for real sign-in (Supabase Auth) -- app/login, middleware.ts,
# lib/supabase-browser.ts, lib/supabase-route-client.ts. The anon key is
# safe to ship to the browser by design; it's still subject to RLS once
# supabase/migrations/0019_user_roles_and_rls.sql is applied.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin key required to call destructive/admin-only routes (full database
# reset, dataset reseeding, flight deletion) -- see lib/admin-guard.ts.
# Pick any long random string; the demo UI will prompt for it once per
# browser session and cache it in sessionStorage. If this is left unset,
# those routes fail closed (503) rather than running un-gated.
ATLAS_ADMIN_KEY=choose-a-long-random-string

# Demo-mode only -- see docs/known-limitations/auth-and-rls.md. Leave BOTH
# unset (or "false") in any real deployment; only set them "true" somewhere
# you deliberately want the old header-based role switcher to keep working
# for people who haven't signed in (e.g. a local/throwaway demo instance).
# NEXT_PUBLIC_ATLAS_DEMO_MODE controls whether the browser shows the
# switcher at all; ATLAS_ALLOW_DEMO_ROLE_HEADER controls whether the server
# will actually honor the header it sends. A real, signed-in session's role
# always wins over this header regardless of either flag -- these only ever
# apply to a signed-OUT request.
NEXT_PUBLIC_ATLAS_DEMO_MODE=false
ATLAS_ALLOW_DEMO_ROLE_HEADER=false
