# Supabase project settings (Project Settings → API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only needed if you later add client-side Supabase reads (not used by this MVP's
# server-only route handlers, but kept here so the pattern is ready if needed).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin key required to call destructive/admin-only routes (full database
# reset, dataset reseeding, flight deletion) -- see lib/admin-guard.ts.
# Pick any long random string; the demo UI will prompt for it once per
# browser session and cache it in sessionStorage. If this is left unset,
# those routes fail closed (503) rather than running un-gated.
ATLAS_ADMIN_KEY=choose-a-long-random-string
